# Docker Compose 的根目录配置模板；复制为 .env 后按部署环境填写。
ATHENA_ENVIRONMENT=development
ATHENA_API_KEY=
ATHENA_CORS_ALLOWED_ORIGINS=
ATHENA_ALLOWED_HOSTS=
ATHENA_DOC_ROOT=

ATHENA_LLM_BASE_URL=https://api.deepseek.com/v1
ATHENA_LLM_API_KEY=
ATHENA_LLM_MODEL=deepseek-chat
ATHENA_REQUEST_TIMEOUT_SECONDS=300
ATHENA_MAX_ITERATIONS=3

# 生产覆盖配置（与 deploy/docker-compose.production.yml 叠加使用时必填）
# ATHENA_DB_USER=
# ATHENA_DB_PASSWORD=
# ATHENA_DB_NAME=
# ATHENA_PG_DSN=postgresql+psycopg://<user>:<url-encoded-password>@db:5432/<db>
