# ===== 模型配置（OpenAI 兼容接口）=====
# DeepSeek 示例
ATHENA_LLM_BASE_URL=https://api.deepseek.com/v1
ATHENA_LLM_API_KEY=
ATHENA_LLM_MODEL=deepseek-chat

# ===== Embedding（可选，未配置时 RAG 使用确定性演示向量）=====
ATHENA_EMBEDDING_BASE_URL=
ATHENA_EMBEDDING_API_KEY=
ATHENA_EMBEDDING_MODEL=

# ===== 编排护栏 =====
# Critic 打回重新检索的最大轮数（防止循环失控）
ATHENA_MAX_ITERATIONS=3
# Critic 通过阈值（0-10 分）
ATHENA_CRITIC_PASS_SCORE=7
# 单次 LLM 请求超时（秒）；订阅制端点限流排队时建议调至 300
ATHENA_REQUEST_TIMEOUT_SECONDS=120

# ===== 检索（可选，留空则使用内置演示数据源）=====
TAVILY_API_KEY=

# ===== 存储后端（可插拔）=====
# 留空 = 进程内内存存储；设置后任务落库（可跨进程查询）。
# sqlite 兜底：ATHENA_PG_DSN=sqlite:///athena.db
# 生产可用 PostgreSQL：ATHENA_PG_DSN=postgresql://user:pass@host:5432/athena
ATHENA_PG_DSN=

# ===== 向量检索后端 =====
# postgres = PostgreSQL + pgvector（需安装 pgvector 扩展与依赖）；memory = 进程内（默认）
ATHENA_VECTOR_STORE=memory

# ===== API 鉴权 =====
# 留空 = 开放（仅本地/内网演示）；生产务必设置，客户端用 Authorization: Bearer <key> 携带
ATHENA_API_KEY=

# ===== CORS 白名单（逗号分隔）=====
# 留空且未设 api_key = 允许全部（本地开发）；设置后仅放行以下前端来源
ATHENA_CORS_ALLOWED_ORIGINS=http://localhost:8080
